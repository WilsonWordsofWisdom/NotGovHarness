        <mxCell id="e-crew-tool" value="wires as Crew's one tool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="crew-layer" target="gw-tool">
          <mxGeometry relative="1" as="geometry" />
