        <mxCell id="e-tool-gateway" value="POST /tools/{name}/call&#10;Bearer (scope agent_gateway:call)&#10;+ reactive 401-retry (D-063 shape)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw-tool" target="agent-gateway">
