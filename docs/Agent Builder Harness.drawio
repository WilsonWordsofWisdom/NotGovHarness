        <!-- Outbound edges -->
        <mxCell id="e-main-identity" value="client_credentials (own client)&#10;+ POST /cards/sign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="main-py" target="identity">
          <mxGeometry relative="1" as="geometry" />
