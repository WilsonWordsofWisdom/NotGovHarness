        <mxCell id="abs-container" value="agent-builder-service  (:8102)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="500" height="320" as="geometry" />
        </mxCell>

        <mxCell id="main-py" value="main.py&#10;POST /builds  (scope builder:build)&#10;GET /builds[/{id}]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="60" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="crew-layer" value="crew_layer.py&#10;CrewLayer: Agent + Task + Crew&#10;LLM -&gt; llm-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="gw-tool" value="agent_gateway_tool.py&#10;AgentGatewayTool (BaseTool)&#10;calls agent-gateway REST, not MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="240" width="220" height="60" as="geometry" />
