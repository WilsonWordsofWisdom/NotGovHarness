        <mxCell id="sync-token" value="sync_token.py&#10;SyncTokenClient&#10;+ reactive 401-retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
