        <!-- External services -->
        <mxCell id="identity" value="identity-service&#10;(:8090)&#10;OAuth2 token + card signing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
