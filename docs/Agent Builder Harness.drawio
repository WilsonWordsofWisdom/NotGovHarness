<mxfile host="app.diagrams.net">
  <diagram name="Agent Builder Harness" id="gjG-icu0BGiyl6Fn0H6o">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Agent Builder Harness — Architecture (Wave 4)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="500" height="30" as="geometry" />
