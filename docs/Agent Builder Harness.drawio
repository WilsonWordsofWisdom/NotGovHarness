        <mxCell id="e-gateway-mcp" value="federates via ContextForge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="agent-gateway" target="mcp-skills-demo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-mcp-skills" value="GET /skills" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="mcp-skills-demo" target="skill-registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-main-registry" value="POST /agents&#10;Bearer (scope registry:publish)&#10;{card, signature}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="main-py" target="agent-registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-main-eval" value="GET /suites?applies_to=&#10;query for real, may return []" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="main-py" target="eval-registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-main-postgres" value="INSERT builds&#10;(id, kickoff_result, tool_was_called,&#10;agent_card_id, eval_suite_names)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="main-py" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
