        </mxCell>

        <mxCell id="postgres" value="Postgres &quot;builder&quot; DB&#10;builds table (audit trail)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="420" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Internal edges -->
        <mxCell id="e-caller-main" value="POST /builds&#10;Bearer (scope builder:build)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="caller" target="main-py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-main-crew" value="run(task, role, goal, backstory)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="main-py" target="crew-layer">
          <mxGeometry relative="1" as="geometry" />
