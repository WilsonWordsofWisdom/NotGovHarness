        <mxCell id="agent-registry" value="agent-registry&#10;(:8092)&#10;signed Agent Card catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
