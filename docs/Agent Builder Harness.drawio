        <mxCell id="eval-registry" value="eval-registry&#10;(:8094)&#10;baseline eval suites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
