        <mxCell id="e-crew-llm" value="chat completions&#10;Bearer (scope llm_gateway:call)&#10;api_key fresh per call (D-071)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="crew-layer" target="llm-gateway">
