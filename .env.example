# Copy to .env for local development. Values below match docker-compose defaults.

# --- service runtime (consumed by platform-core PlatformSettings) ---
ENV=dev
LOG_LEVEL=info
AUTH_MODE=dev

# --- Postgres (db-per-service; each service uses its own logical DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
# example-service DSN (async driver)
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/example_service

# --- Event backbone (Redpanda / Kafka API) ---
KAFKA_BROKERS=localhost:9092

# --- Observability (OTLP to the collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- LLM Gateway (LiteLLM) ---
# Generate your own, e.g.: python3 -c "import secrets; print('sk-litellm-master-' + secrets.token_urlsafe(32))"
# Never commit a real value here -- local .env only.
LITELLM_MASTER_KEY=sk-litellm-master-changeme
# Backend-only virtual key llm-gateway (façade) holds -- mint via:
# curl -X POST http://localhost:4000/key/generate -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
#   -d '{"models":["qwen3.8"],"key_alias":"llm-gateway-facade"}'
LITELLM_VIRTUAL_KEY=sk-litellm-virtual-changeme
