# Copy to .env for local development. Values below match docker-compose defaults.

# --- service runtime (consumed by platform-core PlatformSettings) ---
ENV=dev
LOG_LEVEL=info
AUTH_MODE=dev

# --- Postgres (db-per-service; each service uses its own logical DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
# example-service DSN (async driver)
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/example_service

# --- Event backbone (Redpanda / Kafka API) ---
KAFKA_BROKERS=localhost:9092

# --- Observability (OTLP to the collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
